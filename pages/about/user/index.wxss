.content {
  padding: 24rpx;
}

.require-dot {
  color: #ee0a24;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 16rpx;
  margin-top: 16rpx;
}

.agreement-checkbox {
  flex-shrink: 0;
  margin-right: 12rpx;
  transform: scale(0.85);
}

.agreement-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}

.agreement-link {
  color: #7B9E87;
}

.button-container {
  padding: 40rpx 16rpx;
}
