<view class="container">
  <view class="card content">
    <van-cell-group>
      <van-field
        value="{{ name }}"
        label="姓名"
        required
        maxlength="20"
        placeholder="请输入您的姓名"
        bind:change="onNameChange"
      />
      <van-field
        value="{{ phone }}"
        label="手机号"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        bind:change="onPhoneChange"
      />
    </van-cell-group>

    <view class="agreement-row">
      <checkbox-group bindchange="onAgreementChange">
        <checkbox
          class="agreement-checkbox"
          value="agreed"
          checked="{{ agreedToTerms }}"
          color="#7B9E87"
        />
      </checkbox-group>
      <view class="agreement-text">
        <text>我已阅读并同意</text>
        <text class="agreement-link" catchtap="openTerms">《用户服务协议》</text>
        <text> 和 </text>
        <text class="agreement-link" catchtap="openPrivacy">《隐私政策说明》</text>
      </view>
    </view>

    <view class="button-container">
      <van-button type="primary" block round loading="{{ submitting }}" bind:click="onSubmit">
        保存
      </van-button>
    </view>
  </view>
</view>
