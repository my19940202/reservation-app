<view class="container">
  <swiper
    wx:if="{{banners.length}}"
    class="banner-swiper"
    indicator-dots
    autoplay
    circular
    interval="{{4000}}"
    duration="{{500}}"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-image" src="{{item.image}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="section-title">咨询师</view>
  <van-loading wx:if="{{loading}}" size="24px" vertical>加载中...</van-loading>
  <view wx:elif="{{teachers.length}}" class="card">
    <view
      wx:for="{{teachers}}"
      wx:key="_id"
      class="teacher-item"
      data-id="{{item._id}}"
      data-name="{{item.name}}"
      bindtap="goBooking"
    >
      <image
        wx:if="{{item.avatar}}"
        class="teacher-avatar"
        src="{{item.avatar}}"
        mode="aspectFill"
      />
      <view wx:else class="teacher-avatar teacher-avatar--placeholder">咨</view>
      <view class="teacher-info">
        <text class="teacher-name">{{item.name}}</text>
        <text class="teacher-intro">{{item.intro || '暂无简介'}}</text>
      </view>
      <text class="teacher-arrow">›</text>
    </view>
  </view>
  <van-empty wx:else class="empty-wrap" description="暂无咨询师" />
</view>
