<view class="container">
  <view class="card package-card">
    <view class="package-title">我的咨询次数</view>
    <view wx:if="{{userPackage}}" class="package-stats">
      <view class="stat-item">
        <text class="stat-num">{{userPackage.one_to_one_remaining || 0}}</text>
        <text class="stat-label">一对一剩余</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{userPackage.group_remaining || 0}}</text>
        <text class="stat-label">一对多剩余</text>
      </view>
    </view>
    <van-empty wx:else description="暂无有效次数包" />
  </view>

  <view class="card">
    <van-cell title="选择咨询师预约" is-link bind:click="goTeachers" />
    <van-cell title="我的预约" is-link bind:click="goAppointments" />
  </view>
</view>
