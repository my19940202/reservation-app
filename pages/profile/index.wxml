  <view class="card">
    <van-cell title="编辑资料" is-link bind:click="goEditProfile" />
    <van-cell title="我的预约" is-link bind:click="goAppointments" />
    <van-cell wx:if="{{isTeacher}}" title="待核销" is-link bind:click="goVerify" />
    <van-cell wx:if="{{isAdmin}}" title="管理后台" is-link bind:click="goAdmin" />
  </view>

  <view class="card">
    <van-cell title="用户服务协议" is-link bind:click="openTerms" />
    <van-cell title="隐私政策说明" is-link bind:click="openPrivacy" />
  </view>
</view>
