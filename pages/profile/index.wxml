<view class="container">
  <view class="card profile-header">
    <text class="profile-name">{{userInfo.name || '微信用户'}}</text>
    <text wx:if="{{userInfo.phone}}" class="profile-phone">{{userInfo.phone}}</text>
    <text class="profile-role">{{userInfo.role === 'admin' ? '管理员' : userInfo.role === 'teacher' ? '咨询师' : '用户'}}</text>
  </view>

