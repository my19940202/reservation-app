.profile-header {
  padding: 48rpx 32rpx;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.profile-role {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.profile-phone {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.package-card {
  padding: 40rpx 32rpx;
}

.package-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.package-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #7B9E87;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}
