.content {
  padding: 24rpx 0 32rpx;
}

.avatar-section {
  padding: 0 32rpx 24rpx;
}

.avatar-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #646566;
}

.upload-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.types-section {
  padding: 24rpx 32rpx;
}

.section-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #646566;
}

.type-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.type-item checkbox {
  margin-right: 12rpx;
}

.button-container {
  padding: 32rpx 32rpx 0;
}
