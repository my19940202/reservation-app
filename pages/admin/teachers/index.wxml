<view class="container">
  <view class="card search-bar">
    <van-search
      value="{{ keyword }}"
      placeholder="搜索咨询师姓名"
      bind:change="onSearchChange"
      bind:search="onSearch"
    />
  </view>

  <view class="toolbar">
    <van-button type="primary" size="small" round bind:click="goAdd">新增咨询师</van-button>
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical>加载中...</van-loading>

  <view wx:elif="{{list.length}}" class="card">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="teacher-item"
      data-id="{{item._id}}"
      bindtap="goEdit"
    >
      <image
        wx:if="{{item.avatar}}"
        class="teacher-avatar"
        src="{{item.avatar}}"
        mode="aspectFill"
      />
      <view wx:else class="teacher-avatar teacher-avatar--placeholder">咨</view>
      <view class="teacher-info">
        <view class="teacher-name-row">
          <text class="teacher-name">{{item.name}}</text>
          <van-tag wx:if="{{item.status === 'active'}}" type="success" size="medium">启用</van-tag>
          <van-tag wx:else type="default" size="medium">禁用</van-tag>
        </view>
        <text class="teacher-intro">{{item.intro || '暂无简介'}}</text>
      </view>
      <text class="teacher-arrow">›</text>
    </view>
  </view>

  <van-empty wx:else class="empty-wrap" description="暂无咨询师" />
</view>
