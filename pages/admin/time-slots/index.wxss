.toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 0 24rpx 16rpx;
}

.slot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.slot-item:last-child {
  border-bottom: none;
}

.slot-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.slot-time {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.slot-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}
